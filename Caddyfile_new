{
    email admin@superhumanlythoughts.com
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

superhumanlythoughts.com {
    root * /home/ec2-user/dist
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /health* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /docs* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /openapi.json {
        reverse_proxy 127.0.0.1:8000
    }
    handle /ws* {
        reverse_proxy 127.0.0.1:8000 {
            header_up Upgrade websocket
            header_up Connection Upgrade
        }
    }
    
    file_server
    encode gzip zstd
    header {
        -Server
        Cache-Control "public, max-age=3600"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
    handle /favicon.ico {
        respond "" 204
    }
    @notfile {
        not path /api/*
        not path /health*
        not path /docs*
        not path /openapi.json
        not path /ws*
        not path /assets/*
        not path /js/*
        not path *.js
        not path *.css
        not path *.jpg
        not path *.jpeg
        not path *.png
        not path *.gif
        not path *.webp
        not path *.ico
    }
    rewrite @notfile /index.html
}

www.superhumanlythoughts.com {
    redir https://superhumanlythoughts.com{uri}
}

api.superhumanlythoughts.com {
    @options method OPTIONS
    handle @options {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization, x-role, x-api-key"
        header Content-Length "0"
        respond 204
    }

    @websocket path /ws*
    handle @websocket {
        reverse_proxy 127.0.0.1:8000 {
            header_up Upgrade websocket
            header_up Connection Upgrade
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Access-Control-Allow-Credentials
        }
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization, x-role, x-api-key"
    }

    handle {
        reverse_proxy 127.0.0.1:8000 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Access-Control-Allow-Credentials
        }
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization, x-role, x-api-key"
    }
}
